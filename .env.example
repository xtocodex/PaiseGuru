# Pooled connection for the app (Neon: host with -pooler). Migrations use the direct host automatically.
DATABASE_URL=
# A separate, disposable database. Tests delete all rows in it.
TEST_DATABASE_URL=
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the app (dev: the Vite server)
BETTER_AUTH_URL=http://localhost:5173
# Google sign-in (Google Cloud console, OAuth client). Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dev/test only: email + password login for local testing and e2e. Refused when NODE_ENV=production.
NODE_ENV=development
DEV_LOGIN=1
# API port, and the Vite dev server port (dev only)
PORT=3000
DEV_PORT=5173
